---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { identity } from "@const/identity.js";
import serviceContent from "../content/services.json";
import projects from "../content/projects.json";
import testimonials from "../content/testimonials.json";

const { development: devServices, teaching: teachingServices } = serviceContent;

const featuredDev = devServices[0];
const featuredTeaching = teachingServices[0];
const featuredProjects = projects.slice(0, 2);
---

<BaseLayout>
	<!-- Hero Section -->
	<section class="hero">
		<div class="hero__content">
			<div style="margin-bottom: 1rem;">
				<span class="tag tag-green">● {identity.status}</span>
			</div>
			<h1 class="hero__title">{identity.fullName}</h1>
			<p class="hero__subtitle">{identity.title}</p>
			<p class="hero__description">{identity.tagline}</p>
			<div class="hero__actions">
				<a href="/services/" class="btn btn-primary">Explore Services</a>
				<a href="/portfolio/" class="btn btn-secondary">View Work</a>
				<a href="/contact/" class="btn btn-accent">Book Mentorship</a>
			</div>
		</div>
		<div class="hero__image">
			<img src="/media/hero-illustration.svg" alt="Workspace illustration placeholder" />
		</div>
	</section>

	<!-- Dual Expertise Overview -->
	<section>
		<div class="section-header">
			<h2>What I Do</h2>
			<p>Combining hands-on software engineering with high-impact technical instruction.</p>
		</div>

		<div class="grid-2">
			<div class="card" style="border-left: 4px solid var(--color-accent);">
				<div class="card-header">
					<span class="card-icon">💻</span>
					<span class="tag">Freelance Development</span>
				</div>
				<h3>Web Applications & API Engineering</h3>
				<p>I build production-ready web applications, responsive landing pages, and backend APIs designed for performance, accessibility, and maintainability.</p>
				<div style="margin-top: auto; padding-top: 1rem;">
					<a href="/services/#dev" class="btn btn-secondary btn-sm">Dev Services &rarr;</a>
				</div>
			</div>

			<div class="card" style="border-left: 4px solid var(--color-accent-secondary);">
				<div class="card-header">
					<span class="card-icon">🎓</span>
					<span class="tag tag-teaching">Freelance Teaching</span>
				</div>
				<h3>1-on-1 Mentorship & Workshops</h3>
				<p>I tutor developers of all levels in JavaScript, React, Astro, and full-stack engineering through structured live screen-share sessions and code reviews.</p>
				<div style="margin-top: auto; padding-top: 1rem;">
					<a href="/services/#teaching" class="btn btn-secondary btn-sm">Teaching Options &rarr;</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Featured Services -->
	<section>
		<div class="section-header">
			<h2>Featured Services</h2>
			<p>Popular solutions for business clients and aspiring engineers.</p>
		</div>

		<div class="grid-2">
			<ServiceCard service={featuredDev} />
			<ServiceCard service={featuredTeaching} />
		</div>

		<div style="text-align: center; margin-top: 1.5rem;">
			<a href="/services/" class="btn btn-secondary">View All Services &amp; Pricing &rarr;</a>
		</div>
	</section>

	<!-- Featured Projects -->
	<section>
		<div class="section-header">
			<h2>Selected Projects &amp; Curricula</h2>
			<p>Recent client work, open-source tools, and teaching programs.</p>
		</div>

		<div class="grid-2">
			{featuredProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>

		<div style="text-align: center; margin-top: 1.5rem;">
			<a href="/portfolio/" class="btn btn-secondary">Browse Full Portfolio &rarr;</a>
		</div>
	</section>

	<!-- Testimonials -->
	<section>
		<div class="section-header">
			<h2>Client &amp; Student Feedback</h2>
			<p>What development clients and mentorship students have to say.</p>
		</div>

		<div class="grid-3">
			{testimonials.map((t) => (
				<TestimonialCard testimonial={t} />
			))}
		</div>
	</section>

	<!-- Call to Action Banner -->
	<section style="background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 2.5rem 2rem; text-align: center; margin-top: 4rem;">
		<h2 style="margin-top: 0;">Have a Project in Mind or Want to Learn?</h2>
		<p style="max-width: 42rem; margin: 0.75rem auto 1.75rem;">Whether you need a full-stack web application built from scratch or guidance on your software engineering journey, I'm here to help.</p>
		<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
			<a href="/contact/" class="btn btn-primary">Start a Conversation</a>
			<a href={`mailto:${identity.email}`} class="btn btn-secondary">Direct Email</a>
		</div>
	</section>
</BaseLayout>
